<article class="group overflow-hidden rounded-[1.5rem] border border-ink/10 bg-white shadow-card transition duration-300 hover:-translate-y-1.5">
  <div class="relative flex aspect-[4/3] items-center justify-center overflow-hidden bg-gradient-to-br <%= ['from-amber-100 to-orange-200', 'from-emerald-100 to-teal-200', 'from-sky-100 to-indigo-200', 'from-rose-100 to-pink-200'][book.id % 4] %>">
    <div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(circle at 20% 30%, white 0 2px, transparent 3px); background-size: 22px 22px"></div>
    <div class="relative flex h-36 w-24 rotate-3 flex-col justify-between rounded-r-lg border-l-[5px] border-white/70 bg-ink p-4 text-white shadow-2xl transition duration-500 group-hover:rotate-0 group-hover:scale-105">
      <span class="text-[8px] font-bold uppercase tracking-widest text-brand-100"><%= book.genre?.name || 'Knjiga' %></span>
      <span class="line-clamp-4 text-sm font-black leading-tight"><%= book.title %></span>
      <span class="text-[7px] text-white/60"><%= book.author %></span>
    </div>
    <% if (book.allowExchange) { %>
      <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-emerald-700 shadow-sm">Razmjena</span>
    <% } %>
    <span class="absolute right-4 top-4 grid h-9 w-9 place-items-center rounded-full bg-white/90 text-ink shadow-sm" aria-label="Dodaj u favorite">♡</span>
  </div>
  <div class="p-5">
    <div class="flex items-center justify-between gap-3 text-xs font-semibold text-ink/50">
      <span><%= book.condition?.name || 'Dobro stanje' %></span>
      <span class="flex items-center gap-1 text-amber-600">★ <%= book.averageRating.toFixed(1) %> <span class="text-ink/35">(<%= book.ratingCount %>)</span></span>
    </div>
    <h3 class="mt-3 line-clamp-1 text-lg font-black tracking-tight text-ink"><%= book.title %></h3>
    <p class="mt-1 line-clamp-1 text-sm text-ink/55"><%= book.author %></p>
    <div class="mt-5 flex items-end justify-between border-t border-ink/10 pt-4">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-wider text-ink/35"><%= book.owner.city?.name || book.pickupLocations[0]?.city.name || 'BiH' %></p>
        <p class="mt-0.5 text-xl font-black text-ink"><%= book.price === 0 ? 'Razmjena' : `${book.price.toFixed(2)} KM` %></p>
      </div>
      <a href="#" class="grid h-10 w-10 place-items-center rounded-xl bg-brand-500 text-white transition hover:bg-ink" aria-label="Otvori knjigu">→</a>
    </div>
  </div>
</article>
