<header class="sticky top-0 z-50 border-b border-ink/10 bg-paper/90 backdrop-blur-xl">
  <nav class="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 sm:px-8">
    <a href="/" class="group flex items-center gap-3" aria-label="Bookie naslovna">
      <span class="grid h-10 w-10 place-items-center rounded-xl bg-ink text-paper transition group-hover:-rotate-6">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
      </span>
      <span class="text-2xl font-black tracking-[-0.06em] text-ink">bookie<span class="text-brand-500">.</span></span>
    </a>

    <div class="hidden items-center gap-8 text-sm font-semibold text-ink/70 md:flex">
      <a href="#knjige" class="transition hover:text-ink">Istraži knjige</a>
      <a href="#kako-radi" class="transition hover:text-ink">Kako radi</a>
      <a href="#kategorije" class="transition hover:text-ink">Kategorije</a>
    </div>

    <div class="flex items-center gap-2 sm:gap-3">
      <% if (currentUser) { %>
        <a href="<%= auth.PATHS.ACCOUNT %>" class="rounded-xl px-3 py-2 text-sm font-bold text-ink"><%= currentUser.firstName %></a>
        <form action="<%= auth.PATHS.LOGOUT %>" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="rounded-xl bg-ink px-4 py-2.5 text-sm font-bold text-white"><%= authText.LOGOUT %></button>
        </form>
      <% } else { %>
        <a href="<%= auth.PATHS.LOGIN %>" class="rounded-xl px-3 py-2.5 text-sm font-bold text-ink transition hover:bg-ink/5"><%= authText.LOGIN_BUTTON %></a>
        <a href="<%= auth.PATHS.REGISTER %>" class="rounded-xl bg-ink px-4 py-2.5 text-sm font-bold text-white shadow-lg shadow-ink/15 transition hover:-translate-y-0.5 hover:bg-brand-600 sm:px-5"><%= authText.REGISTER_BUTTON %></a>
      <% } %>
    </div>
  </nav>
</header>
