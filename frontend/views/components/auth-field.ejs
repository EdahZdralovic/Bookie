<div class="auth-field">
  <label for="<%= name %>"><%= label %></label>
  <div class="auth-input-wrap <%= type === 'password' ? 'has-toggle' : '' %>">
    <input id="<%= name %>" name="<%= name %>" type="<%= type %>" autocomplete="<%= autocomplete %>"
      <% if (type !== 'password') { %>value="<%= values[name] || '' %>"<% } %>
      <% if (name === 'firstName' || name === 'lastName') { %>maxlength="<%= auth.NAME_MAX_LENGTH %>"<% } %>
      <% if (type === 'email') { %>maxlength="<%= auth.EMAIL_MAX_LENGTH %>" autocapitalize="none" spellcheck="false"<% } %>
      <% if (type === 'password') { %>maxlength="<%= auth.PASSWORD.MAX_BYTES %>"<% } %>
      required aria-invalid="<%= Boolean(errors[name]) %>" aria-describedby="<%= name %>-error<%= name === 'password' && page === 'register' ? ' password-rules' : '' %>">
    <% if (type === 'password') { %>
      <button type="button" class="password-toggle" data-toggle="<%= name %>" aria-label="<%= authText.SHOW_PASSWORD %>" aria-controls="<%= name %>" aria-pressed="false" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
      </button>
    <% } %>
  </div>
  <p class="field-error" id="<%= name %>-error" data-error-for="<%= name %>" aria-live="polite"><%= errors[name] || '' %></p>
</div>
