<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> — Bookie</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/auth.css" />
  </head>
  <body class="account-body">
    <%- include('../components/header') %>
    <main class="form-page statistics-page">
      <p class="auth-step">ADMINISTRATION</p>
      <h1>Marketplace statistics</h1>
      <p class="auth-description">Monitor the health and activity of the Bookie marketplace.</p>
      <section class="stats-cards" aria-label="Marketplace summary">
        <% [['Total users', statistics.userCount], ['Sellers', statistics.sellerCount], ['Buyers',
        statistics.buyerCount], ['Total books', statistics.totalBookCount], ['Active listings',
        statistics.activeBookCount], ['Completed orders and exchanges',
        statistics.completedOrderCount], ['Average books per seller',
        statistics.averageBooksPerSeller.toFixed(1)]].forEach(([label, value]) => { %>
        <article class="stat-card">
          <span><%= label %></span>
          <strong>
            <%= value %>
          </strong>
        </article>
        <% }) %>
      </section>
      <section class="statistics-grid">
        <div class="workflow-form statistics-panel">
          <h2>Most popular genres</h2>
          <% const maxGenreCount = Math.max(...statistics.popularGenres.map((genre) => genre.count),
          1); %>
          <% if (!statistics.popularGenres.length) { %>
          <p class="field-hint">No genre data is available yet.</p>
          <% } %>
          <% statistics.popularGenres.forEach((genre) => { %>
          <div class="genre-row">
            <div class="genre-label">
              <span><%= genre.name %></span>
              <strong>
                <%= genre.count %>
              </strong>
            </div>
            <div class="genre-bar">
              <span style="width: <%= Math.round((genre.count / maxGenreCount) * 100) %>%"></span>
            </div>
          </div>
          <% }) %>
        </div>
        <div class="workflow-form statistics-panel">
          <h2>Genre table</h2>
          <table class="statistics-table">
            <thead>
              <tr>
                <th>Rank</th>
                <th>Genre</th>
                <th>Books</th>
              </tr>
            </thead>
            <tbody>
              <% statistics.popularGenres.forEach((genre, index) => { %>
              <tr>
                <td>
                  <%= index + 1 %>
                </td>
                <td>
                  <%= genre.name %>
                </td>
                <td>
                  <%= genre.count %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
      <section class="chart-grid">
        <div class="workflow-form statistics-panel">
          <h2>Books by language</h2>
          <div class="chart-wrap">
            <canvas id="languageChart" aria-label="Books by language pie chart"> </canvas>
          </div>
        </div>
        <div class="workflow-form statistics-panel">
          <h2>Completed sales and exchanges</h2>
          <div class="chart-wrap">
            <canvas id="ordersChart" aria-label="Completed sales and exchanges line chart">
            </canvas>
          </div>
        </div>
        <div class="workflow-form statistics-panel">
          <h2>Genre distribution</h2>
          <div class="chart-wrap">
            <canvas id="genreChart" aria-label="Genre distribution spider chart"> </canvas>
          </div>
        </div>
      </section>
    </main>

    <div id="statistics-data" hidden data-statistics="<%= JSON.stringify(statistics) %>" data-labels="<%= JSON.stringify(strings.WORKFLOW) %>"></div>
    <script src="/vendor/chart.js" defer></script>
    <script src="/js/statistics.js" defer></script>
  </body>
</html>
