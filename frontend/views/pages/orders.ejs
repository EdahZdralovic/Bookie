<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Orders — Bookie</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/auth.css" />
  </head>
  <body class="account-body">
    <main class="form-page">
      <h1>Orders</h1>
      <div class="seller-book-list">
        <% orders.forEach((order) => { %>
        <article class="seller-book-row">
          <div class="seller-book-info">
            <strong>
              <%= order.orderNumber %>
            </strong>
            <span>
              <%= order.items.length %>
              item(s) ·
              <%= order.status %>
              ·
              <%= new Date(order.createdAt).toLocaleDateString('en-US') %>
            </span>
          </div>
          <strong>
            <%= Number(order.totalAmount).toFixed(2) %>
            BAM</strong>
          <% if (currentUser.role === 'SELLER' && order.status === 'PENDING') { %>
          <form method="post" action="/orders/<%= order.id %>/status">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button name="status" value="ACCEPTED">Accept</button>
            <button name="status" value="REJECTED">Reject</button>
          </form>
          <% } else if (currentUser.role === 'SELLER' && order.status === 'ACCEPTED') { %>
          <form method="post" action="/orders/<%= order.id %>/status">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button name="status" value="COMPLETED">Complete</button>
          </form>
          <% } else if (currentUser.role === 'BUYER' && order.status === 'PENDING') { %>
          <form method="post" action="/orders/<%= order.id %>/status">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button name="status" value="CANCELLED">Cancel</button>
          </form>
          <% } %>
          <% if (currentUser.role === 'BUYER' && order.status === 'COMPLETED') {
          order.items.forEach((item) => { %>
          <form method="post" action="/reviews/<%= item.id %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <select name="rating" required>
              <option value="">Rating</option>
              <% [1,2,3,4,5].forEach((rating) => { %>
              <option value="<%= rating %>"><%= rating %>/5</option>
              <% }) %>
            </select>
            <input name="comment" placeholder="Comment" />
            <button type="submit">Review</button>
          </form>
          <% }) } %>
        </article>
        <% }) %>
        <% if (!orders.length) { %>
        <p class="field-hint">No orders yet.</p>
        <% } %>
      </div>
    </main>
  </body>
</html>
