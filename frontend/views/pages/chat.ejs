<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Conversation — Bookie</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/auth.css" />
  </head>
  <body class="account-body">
    <%- include('../components/header') %>
    <main class="form-page">
      <a class="auth-back" href="/chat/list">← Messages</a>
      <h1>
        <%= conversation.participants.find((item) => item.user.id !==
        currentUser.id)?.user.firstName || 'Conversation' %>
      </h1>
      <div class="chat-messages">
        <% conversation.messages.forEach((message) => { %>
        <article class="chat-message <%= message.sender.id === currentUser.id ? 'mine' : '' %>">
          <strong>
            <%= message.sender.firstName %>
          </strong>
          <p><%= message.body %></p>
          <small>
            <%= new Date(message.createdAt).toLocaleString('en-US') %>
          </small>
        </article>
        <% }) %>
      </div>
      <form class="workflow-form" method="post" action="/chat/<%= conversation.id %>/messages">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <textarea name="body" rows="3" required placeholder="Write a message..."></textarea>
        <button class="auth-submit" type="submit">Send message <span>↗</span></button>
      </form>
    </main>
  </body>
</html>
