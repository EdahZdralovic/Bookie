<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Explore used books on Bookie">
<title>
<%= title %> — Bookie</title>
<link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-paper">
<%- include('../components/header') %>
<main>
<section class="border-b border-ink/10 bg-white">
<div class="mx-auto max-w-7xl px-5 py-14 sm:px-8">
<p class="text-xs font-black uppercase tracking-[.2em] text-brand-600">BOOK CATALOG</p>
<h1 class="mt-3 text-4xl font-black tracking-tight text-ink sm:text-5xl">Explore books</h1>
<p class="mt-3 max-w-2xl text-ink/60">Search the complete collection of books available from our community.</p>
<form action="/books" method="get" class="mt-8 flex flex-col gap-3 rounded-2xl border border-ink/10 bg-paper p-3 shadow-card">
<label class="flex items-center gap-3 px-3">
<span aria-hidden="true">⌕</span>
<input class="h-12 w-full bg-transparent text-sm outline-none" type="search" name="q" value="<%= search %>" placeholder="Search by title, author or ISBN...">
</label>
<div class="grid grid-cols-2 gap-2 border-t border-ink/10 pt-3 sm:grid-cols-4">
<select name="genreId" class="h-11 rounded-xl bg-white px-3 text-sm font-semibold">
<option value="">All genres</option>
<% genres.forEach((genre) => { %>
<option value="<%= genre.id %>" <%= String(filters.genreId || '') === String(genre.id) ? 'selected' : '' %>>
<%= genre.name %>
</option>
<% }) %>
</select>
<select name="languageId" class="h-11 rounded-xl bg-white px-3 text-sm font-semibold">
<option value="">All languages</option>
<% languages.forEach((language) => { %>
<option value="<%= language.id %>" <%= String(filters.languageId || '') === String(language.id) ? 'selected' : '' %>>
<%= language.name %>
</option>
<% }) %>
</select>
<select name="cityId" class="h-11 rounded-xl bg-white px-3 text-sm font-semibold">
<option value="">All cities</option>
<% cities.forEach((city) => { %>
<option value="<%= city.id %>" <%= String(filters.cityId || '') === String(city.id) ? 'selected' : '' %>>
<%= city.name %>
</option>
<% }) %>
</select>
<select name="conditionId" class="h-11 rounded-xl bg-white px-3 text-sm font-semibold">
<option value="">All conditions</option>
<% conditions.forEach((condition) => { %>
<option value="<%= condition.id %>" <%= String(filters.conditionId || '') === String(condition.id) ? 'selected' : '' %>>
<%= condition.name %>
</option>
<% }) %>
</select>
<input name="minPrice" type="number" min="0" step="0.01" placeholder="Min price" value="<%= filters.minPrice ?? '' %>" class="h-11 rounded-xl bg-white px-3 text-sm">
<input name="maxPrice" type="number" min="0" step="0.01" placeholder="Max price" value="<%= filters.maxPrice ?? '' %>" class="h-11 rounded-xl bg-white px-3 text-sm">
<label class="flex items-center gap-2 text-sm font-semibold">
<input type="checkbox" name="exchangeOnly" value="1" <%= filters.exchangeOnly ? 'checked' : '' %>> Exchange only</label>
<select name="sort" class="h-11 rounded-xl bg-white px-3 text-sm font-semibold">
<option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest</option>
<option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest</option>
<option value="price-asc" <%= filters.sort === 'price-asc' ? 'selected' : '' %>>Lowest price</option>
<option value="price-desc" <%= filters.sort === 'price-desc' ? 'selected' : '' %>>Highest price</option>
</select>
</div>
<button class="rounded-xl bg-brand-500 px-7 py-3 text-sm font-black text-white" type="submit">Search catalog</button>
</form>
</div>
</section>
<section class="mx-auto max-w-7xl px-5 py-14 sm:px-8">
<div class="flex items-end justify-between">
<div>
<p class="text-xs font-black uppercase tracking-[.2em] text-brand-600">RESULTS</p>
<h2 class="mt-2 text-3xl font-black">
<%= books.length %> books found</h2>
</div>
<a href="/" class="text-sm font-bold underline">Back home</a>
</div>
<% if (books.length) { %>
<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
<% books.forEach((book) => { %>
<%- include('../components/book-card', { book }) %>
<% }) %>
</div>
<% } else { %>
<div class="mt-8 rounded-3xl border border-dashed border-ink/20 bg-white p-10 text-center text-ink/50">No books match your search.</div>
<% } %>
</section>
</main>
<%- include('../components/footer') %>
</body>
</html>
