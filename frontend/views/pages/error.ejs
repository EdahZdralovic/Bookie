<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> — Bookie</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="account-body">
    <main class="mx-auto max-w-2xl px-6 py-24 text-center">
      <h1 class="text-4xl font-black"><%= title %></h1>
      <p class="mt-4 text-slate-600"><%= message %></p>
      <div class="mt-8 flex justify-center gap-4">
        <a
          href="<%= auth.PATHS.HOME %>"
          class="rounded-lg bg-brand-600 px-5 py-3 font-semibold text-white hover:bg-brand-700"
        >
          <%= authText.BACK_HOME %>
        </a>
        <% if (!currentUser) { %>
        <a
          href="<%= auth.PATHS.LOGIN %>"
          class="rounded-lg bg-ink px-5 py-3 font-semibold text-white"
        >
          <%= authText.LOGIN_BUTTON %>
        </a>
        <% } %>
      </div>
    </main>
  </body>
</html>
