<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Bookie</title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/auth.css">
</head>
<body class="account-body">
  <main class="form-page profile-page">
    <a class="auth-back" href="/account">← <%= strings.PROFILE.ACCOUNT %></a>
    <div class="profile-heading"><div class="profile-preview"><% if (values.avatarUrl) { %><img src="<%= values.avatarUrl %>" alt="Profile preview"><% } else { %><span><%= profile.firstName.charAt(0) %><%= profile.lastName.charAt(0) %></span><% } %></div><div><p class="auth-step"><%= strings.PROFILE.EYEBROW %></p><h1><%= strings.PROFILE.HEADING %></h1><p class="auth-description"><%= strings.PROFILE.DESCRIPTION %></p></div></div>
    <% if (saved) { %><p class="success-alert" role="status"><%= strings.PROFILE.SUCCESS %></p><% } %>
    <form class="workflow-form" method="post" action="/profile" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (formError) { %><div class="form-alert" role="alert"><span class="alert-icon">!</span><div><strong><%= strings.COMMON.ERROR_TITLE %></strong><p><%= formError %></p></div></div><% } %>
      <div class="auth-field"><label for="avatarUrl"><%= strings.PROFILE.AVATAR %></label><input id="avatarUrl" name="avatarUrl" type="url" value="<%= values.avatarUrl || '' %>" placeholder="https://..."><p class="field-hint"><%= strings.PROFILE.AVATAR_HINT %></p><p class="field-error"><%= errors.avatarUrl || '' %></p></div>
      <div class="interests-panel"><p class="interest-hint"><%= strings.PROFILE.INTEREST_HINT %></p>
        <% [['genreIds', strings.PROFILE.GENRES, genres], ['languageIds', strings.PROFILE.LANGUAGES, languages]].forEach(([name, label, choices]) => { %><fieldset class="auth-field interest-field"><legend><%= label %></legend><div class="interest-options"><% choices.forEach((choice) => { %><label class="interest-chip"><input type="checkbox" name="<%= name %>" value="<%= choice.id %>" <%= (values[name] || []).map(String).includes(String(choice.id)) ? 'checked' : '' %>><span><%= choice.name %></span></label><% }) %></div><p class="field-error"><%= errors[name] || errors.interests || '' %></p></fieldset><% }) %>
      </div>
      <button class="auth-submit" type="submit"><%= strings.PROFILE.SAVE %><span>↗</span></button>
    </form>
    <% if (profile.role === 'SELLER') { %>
      <section class="seller-books"><div class="seller-books-heading"><div><p class="auth-step">YOUR LISTINGS</p><h2>My books</h2></div><a class="auth-submit compact-action" href="/books/new">Add a book <span>↗</span></a></div>
        <form class="listing-filters" method="get" action="/profile"><label>Status<select name="status"><option value="">All books</option><option value="ACTIVE" <%= filters.status === 'ACTIVE' ? 'selected' : '' %>>Active</option><option value="SOLD" <%= filters.status === 'SOLD' ? 'selected' : '' %>>Sold</option><option value="ARCHIVED" <%= filters.status === 'ARCHIVED' ? 'selected' : '' %>>Archived</option></select></label><label>Sort by<select name="sort"><option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Date added</option><option value="price" <%= filters.sort === 'price' ? 'selected' : '' %>>Price</option><option value="title" <%= filters.sort === 'title' ? 'selected' : '' %>>Title</option></select></label><button class="filter-button" type="submit">Apply filters</button></form>
        <div class="seller-book-list"><% sellerBooks.forEach((book) => { %><a class="seller-book-row" href="/books/<%= book.publicId %>"><div class="seller-book-thumb"><% if (book.imageUrl) { %><img src="<%= book.imageUrl %>" alt=""><% } else { %><span><%= book.title.charAt(0) %></span><% } %></div><div class="seller-book-info"><strong><%= book.title %></strong><span><%= book.author %> · <%= book.genre.name %></span></div><span class="listing-status status-<%= book.status.toLowerCase() %>"><%= book.status.charAt(0) + book.status.slice(1).toLowerCase() %></span><strong class="seller-book-price"><%= Number(book.price).toFixed(2) %> KM</strong></a><% }) %><% if (!sellerBooks.length) { %><p class="field-hint">No books match these filters.</p><% } %></div>
      </section>
    <% } %>
  </main>
</body>
</html>
