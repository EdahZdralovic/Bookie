<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Messages — Bookie</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/auth.css" />
  </head>
  <body class="account-body">
    <%- include('../components/header') %>
    <main class="form-page">
      <p class="auth-step">COMMUNICATION</p>
      <h1>Your messages</h1>
      <p class="auth-description">Conversations with buyers, sellers and administrators.</p>
      <div class="review-list">
        <% conversations.forEach((conversation) => { const other =
        conversation.participants.find((item) => item.user.id !== currentUser.id)?.user; const last
        = conversation.messages[0]; %>
        <a class="review-card" href="/chat?conversationId=<%= conversation.id %>">
          <strong>
            <%= other ? `${other.firstName} ${other.lastName}` : 'Conversation' %>
          </strong>
          <p><%= last?.body || 'No messages yet.' %></p>
          <% const participant = conversation.participants.find((item) => item.userId === currentUser.id); %>
          <% if (last && last.senderId !== currentUser.id && (!participant.lastReadAt || last.createdAt > participant.lastReadAt)) { %>
            <span class="auth-step"><%= strings.WORKFLOW.UNREAD %></span>
          <% } %>
        </a>
        <% }) %>
        <% if (!conversations.length) { %>
        <p class="field-hint">No conversations yet.</p>
        <% } %>
      </div>
    </main>
  </body>
</html>
