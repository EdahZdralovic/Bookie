<!doctype html>
<html lang="bs">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Bookie — platforma za prodaju i razmjenu korištenih knjiga.">
    <title><%= title %> — Knjige koje nastavljaju priču</title>
    <link rel="stylesheet" href="/css/styles.css">
    <script src="/js/main.js" defer></script>
  </head>
  <body class="bg-paper">
    <%- include('../components/header') %>

    <main>
      <section class="relative overflow-hidden border-b border-ink/10">
        <div class="absolute -right-24 -top-20 h-96 w-96 rounded-full bg-brand-100 blur-3xl"></div>
        <div class="absolute -bottom-40 left-1/3 h-80 w-80 rounded-full bg-emerald-100 blur-3xl"></div>
        <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[1.08fr_.92fr] lg:py-24">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/20 bg-white/70 px-4 py-2 text-xs font-bold text-brand-700 shadow-sm">
              <span class="h-2 w-2 rounded-full bg-brand-500"></span> Knjige zaslužuju drugo poglavlje
            </div>
            <h1 class="mt-7 max-w-3xl text-5xl font-black leading-[.96] tracking-[-0.065em] text-ink sm:text-6xl lg:text-7xl">Tvoja sljedeća knjiga je već <span class="relative whitespace-nowrap text-brand-600">nečija priča.<svg class="absolute -bottom-2 left-0 w-full text-brand-400" viewBox="0 0 300 12" fill="none"><path d="M2 9C70 2 190 2 298 7" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span></h1>
            <p class="mt-7 max-w-xl text-lg leading-8 text-ink/60">Kupi, prodaj ili razmijeni korištene knjige sa studentima i čitaocima u svom gradu.</p>

            <form action="/" method="get" class="mt-9 flex max-w-2xl flex-col gap-2 rounded-2xl border border-ink/10 bg-white p-2 shadow-card sm:flex-row">
              <label class="flex flex-1 items-center gap-3 px-3">
                <svg class="h-5 w-5 shrink-0 text-ink/35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="search" name="q" value="<%= search %>" placeholder="Naslov, autor ili ISBN..." class="h-12 w-full bg-transparent text-sm font-medium outline-none placeholder:text-ink/35">
              </label>
              <button class="rounded-xl bg-brand-500 px-7 py-3 text-sm font-black text-white transition hover:bg-brand-600">Pronađi knjigu</button>
            </form>
            <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-xs font-semibold text-ink/45">
              <span>✓ Bez naknade za objavu</span><span>✓ Lokalno preuzimanje</span><span>✓ Sigurna zajednica</span>
            </div>
          </div>

          <div class="relative hidden min-h-[510px] lg:block" aria-hidden="true">
            <div class="absolute left-14 top-9 h-96 w-64 -rotate-6 rounded-[2rem] bg-brand-500 shadow-2xl shadow-brand-900/20"></div>
            <div class="absolute left-28 top-2 flex h-96 w-64 rotate-3 flex-col justify-between rounded-[2rem] bg-ink p-8 text-white shadow-2xl">
              <div><p class="text-xs font-bold uppercase tracking-[.25em] text-brand-400">Book of the week</p><div class="mt-8 h-px bg-white/20"></div></div>
              <div><p class="text-4xl font-black leading-none">Čitaj.<br>Podijeli.<br>Ponovi.</p><p class="mt-6 text-xs text-white/45">BOOKIE COLLECTION · 2026</p></div>
            </div>
            <div class="absolute bottom-3 right-0 w-64 rounded-2xl border border-ink/10 bg-white p-5 shadow-card">
              <div class="flex items-center gap-3"><span class="grid h-10 w-10 place-items-center rounded-full bg-emerald-100 text-emerald-700">↻</span><div><p class="text-sm font-black text-ink"><%= stats.completedOrderCount %> uspješna razmjena</p><p class="text-xs text-ink/45">i zajednica koja raste</p></div></div>
            </div>
            <div class="absolute right-1 top-20 rounded-2xl bg-white p-4 shadow-card"><p class="text-xs font-bold text-ink/40">Aktivni oglasi</p><p class="mt-1 text-3xl font-black text-ink"><%= stats.activeBooks %><span class="text-brand-500">+</span></p></div>
          </div>
        </div>
      </section>

      <section id="kategorije" class="border-b border-ink/10 bg-white">
        <div class="mx-auto flex max-w-7xl gap-3 overflow-x-auto px-5 py-5 sm:px-8">
          <a href="/" class="shrink-0 rounded-full bg-ink px-5 py-2.5 text-xs font-bold text-white">Sve knjige</a>
          <% genres.forEach((genre) => { %><a href="/?q=<%= encodeURIComponent(genre.name) %>" class="shrink-0 rounded-full border border-ink/10 px-5 py-2.5 text-xs font-bold text-ink/65 transition hover:border-brand-500 hover:text-brand-600"><%= genre.name %></a><% }) %>
        </div>
      </section>

      <div class="mx-auto max-w-7xl px-5 pb-24 sm:px-8" id="knjige">
        <%- include('../components/book-section', { sectionId: 'popularne', eyebrow: 'Čitaoci biraju', heading: search ? `Rezultati za “${search}”` : 'Najpopularnije knjige', description: 'Najbolje ocijenjene knjige sa najviše uspješno završenih narudžbi.', books: popularBooks }) %>
        <% if (!search) { %>
          <%- include('../components/book-section', { sectionId: 'preporuke', eyebrow: 'Baš za tebe', heading: 'Preporučene knjige', description: 'Izbor prema interesima za stručnu literaturu, romane i omiljene jezike.', books: recommendedBooks }) %>
          <%- include('../components/book-section', { sectionId: 'otkrij', eyebrow: 'Otkrij nešto novo', heading: 'Nasumično odabrane', description: 'Ponekad je najbolja knjiga ona koju nisi planirao pronaći.', books: randomBooks }) %>
        <% } %>
      </div>

      <section id="kako-radi" class="bg-ink py-20 text-white">
        <div class="mx-auto max-w-7xl px-5 sm:px-8">
          <div class="max-w-xl"><p class="text-xs font-black uppercase tracking-[.2em] text-brand-400">Jednostavno i sigurno</p><h2 class="mt-3 text-4xl font-black tracking-tight">Od police do novog čitaoca u tri koraka.</h2></div>
          <div class="mt-12 grid gap-px overflow-hidden rounded-3xl bg-white/10 md:grid-cols-3">
            <% [['01', 'Pronađi knjigu', 'Pretraži po naslovu, autoru, žanru, jeziku, gradu ili cijeni.'], ['02', 'Dogovori detalje', 'Pošalji narudžbu ili ponudu za razmjenu i razgovaraj s prodavačem.'], ['03', 'Preuzmi i ocijeni', 'Preuzmi knjigu na sigurnom mjestu i podijeli iskustvo sa zajednicom.']].forEach((step) => { %>
              <article class="bg-ink p-8 sm:p-10"><span class="text-5xl font-black text-white/10"><%= step[0] %></span><h3 class="mt-8 text-xl font-black"><%= step[1] %></h3><p class="mt-3 text-sm leading-6 text-white/50"><%= step[2] %></p></article>
            <% }) %>
          </div>
        </div>
      </section>

      <section class="bg-brand-500 px-5 py-16 text-center text-white">
        <p class="text-xs font-black uppercase tracking-[.2em] text-brand-100">Imaš knjige koje više ne čitaš?</p>
        <h2 class="mx-auto mt-4 max-w-2xl text-4xl font-black tracking-tight sm:text-5xl">Pretvori svoju policu u nečiju novu avanturu.</h2>
        <a href="#" class="mt-8 inline-block rounded-xl bg-ink px-7 py-4 text-sm font-black shadow-xl transition hover:-translate-y-1">Objavi knjigu besplatno →</a>
      </section>
    </main>

    <%- include('../components/footer') %>
  </body>
</html>
