<!doctype html>
  <html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Bookie — a platform for selling and exchanging used books.">
    <title><%= title %> — Books that keep their story going</title>
    <link rel="stylesheet" href="/css/styles.css">
    <script src="/js/main.js" defer></script>
  </head>
  <body class="bg-paper">
    <main>
      <section class="relative overflow-hidden border-b border-ink/10">
        <div class="absolute -right-24 -top-20 h-96 w-96 rounded-full bg-brand-100 blur-3xl"></div>
        <div class="absolute -bottom-40 left-1/3 h-80 w-80 rounded-full bg-emerald-100 blur-3xl"></div>
        <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[1.08fr_.92fr] lg:py-24">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/20 bg-white/70 px-4 py-2 text-xs font-bold text-brand-700 shadow-sm">
              <span class="h-2 w-2 rounded-full bg-brand-500"></span> Books deserve a second chapter
            </div>
            <h1 class="mt-7 max-w-3xl text-5xl font-black leading-[.96] tracking-[-0.065em] text-ink sm:text-6xl lg:text-7xl">Your next book is already <span class="relative whitespace-nowrap text-brand-600">someone’s story.<svg class="absolute -bottom-2 left-0 w-full text-brand-400" viewBox="0 0 300 12" fill="none"><path d="M2 9C70 2 190 2 298 7" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span></h1>
            <p class="mt-7 max-w-xl text-lg leading-8 text-ink/60">Buy, sell or exchange used books with students and readers in your city.</p>

            <form action="/" method="get" class="mt-9 flex w-full max-w-4xl flex-col gap-2 rounded-2xl border border-ink/10 bg-white p-2 shadow-card">
              <label class="flex flex-1 items-center gap-3 px-3">
                <svg class="h-5 w-5 shrink-0 text-ink/35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="search" name="q" value="<%= search %>" placeholder="Title, author or ISBN..." class="h-12 w-full bg-transparent text-sm font-medium outline-none placeholder:text-ink/35">
              </label>
              <div class="flex flex-col gap-2 border-t border-ink/10 pt-2 sm:flex-row"><select name="genreId" class="h-11 flex-1 rounded-xl bg-paper px-3 text-sm font-semibold text-ink/70"><option value="">All genres</option><% genres.forEach((genre) => { %><option value="<%= genre.id %>" <%= String(filters.genreId || '') === String(genre.id) ? 'selected' : '' %>><%= genre.name %></option><% }) %></select><select name="languageId" class="h-11 flex-1 rounded-xl bg-paper px-3 text-sm font-semibold text-ink/70"><option value="">All languages</option><% languages.forEach((language) => { %><option value="<%= language.id %>" <%= String(filters.languageId || '') === String(language.id) ? 'selected' : '' %>><%= language.name %></option><% }) %></select><button class="rounded-xl bg-brand-500 px-7 py-3 text-sm font-black text-white transition hover:bg-brand-600">Find a book</button></div>
            </form>
            <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-xs font-semibold text-ink/45">
              <span>✓ Free to list</span><span>✓ Local pickup</span><span>✓ Trusted community</span>
            </div>
          </div>

          <div class="relative hidden min-h-[510px] lg:block" aria-hidden="true">
            <div class="absolute left-14 top-9 h-96 w-64 -rotate-6 rounded-[2rem] bg-brand-500 shadow-2xl shadow-brand-900/20"></div>
            <div class="absolute left-28 top-2 flex h-96 w-64 rotate-3 flex-col justify-between rounded-[2rem] bg-ink p-8 text-white shadow-2xl">
              <div><p class="text-xs font-bold uppercase tracking-[.25em] text-brand-400">Book of the week</p><div class="mt-8 h-px bg-white/20"></div></div>
              <div><p class="text-4xl font-black leading-none">Read.<br>Share.<br>Repeat.</p><p class="mt-6 text-xs text-white/45">BOOKIE COLLECTION · 2026</p></div>
            </div>
            <div class="absolute bottom-3 right-0 w-64 rounded-2xl border border-ink/10 bg-white p-5 shadow-card">
              <div class="flex items-center gap-3"><span class="grid h-10 w-10 place-items-center rounded-full bg-emerald-100 text-emerald-700">↻</span><div><p class="text-sm font-black text-ink"><%= stats.completedOrderCount %> successful exchanges</p><p class="text-xs text-ink/45">and a growing community</p></div></div>
            </div>
            <div class="absolute right-1 top-20 rounded-2xl bg-white p-4 shadow-card"><p class="text-xs font-bold text-ink/40">Active listings</p><p class="mt-1 text-3xl font-black text-ink"><%= stats.activeBooks %><span class="text-brand-500">+</span></p></div>
          </div>
        </div>
      </section>

      <section id="categories" class="border-b border-ink/10 bg-white">
        <div class="mx-auto flex max-w-7xl gap-3 overflow-x-auto px-5 py-5 sm:px-8">
          <a href="/" class="shrink-0 rounded-full bg-ink px-5 py-2.5 text-xs font-bold text-white">All books</a>
          <% genres.forEach((genre) => { %><a href="/?q=<%= encodeURIComponent(genre.name) %>" class="shrink-0 rounded-full border border-ink/10 px-5 py-2.5 text-xs font-bold text-ink/65 transition hover:border-brand-500 hover:text-brand-600"><%= genre.name %></a><% }) %>
        </div>
      </section>

      <div class="mx-auto max-w-7xl px-5 pb-24 sm:px-8" id="books">
        <%- include('../components/book-section', { sectionId: 'popularne', eyebrow: 'Readers choose', heading: search ? `Results for “${search}”` : 'Most popular books', description: 'Top-rated books with the most successfully completed orders.', books: popularBooks }) %>
        <% if (!search) { %>
          <%- include('../components/book-section', { sectionId: 'preporuke', eyebrow: 'Picked for you', heading: 'Recommended books', description: 'A selection based on your favorite genres and languages.', books: recommendedBooks }) %>
          <%- include('../components/book-section', { sectionId: 'otkrij', eyebrow: 'Discover something new', heading: 'Random picks', description: 'Sometimes the best book is the one you did not plan to find.', books: randomBooks }) %>
        <% } %>
      </div>

      <section id="how-it-works" class="bg-ink py-20 text-white">
        <div class="mx-auto max-w-7xl px-5 sm:px-8">
          <div class="max-w-xl"><p class="text-xs font-black uppercase tracking-[.2em] text-brand-400">Simple and safe</p><h2 class="mt-3 text-4xl font-black tracking-tight">From shelf to new reader in three steps.</h2></div>
          <div class="mt-12 grid gap-px overflow-hidden rounded-3xl bg-white/10 md:grid-cols-3">
            <% [['01', 'Find a book', 'Search by title, author, genre, language, city or price.'], ['02', 'Agree on the details', 'Send an order or exchange offer and chat with the seller.'], ['03', 'Pick up and review', 'Collect your book at a safe place and share your experience.']].forEach((step) => { %>
              <article class="bg-ink p-8 sm:p-10"><span class="text-5xl font-black text-white/10"><%= step[0] %></span><h3 class="mt-8 text-xl font-black"><%= step[1] %></h3><p class="mt-3 text-sm leading-6 text-white/50"><%= step[2] %></p></article>
            <% }) %>
          </div>
        </div>
      </section>

      <section class="bg-brand-500 px-5 py-16 text-center text-white">
        <p class="text-xs font-black uppercase tracking-[.2em] text-brand-100">Have books you no longer read?</p>
        <h2 class="mx-auto mt-4 max-w-2xl text-4xl font-black tracking-tight sm:text-5xl">Turn your shelf into someone’s next adventure.</h2>
        <a href="/books/new" class="mt-8 inline-block rounded-xl bg-ink px-7 py-4 text-sm font-black shadow-xl transition hover:-translate-y-1">List a book for free →</a>
      </section>
    </main>
  </body>
</html>
