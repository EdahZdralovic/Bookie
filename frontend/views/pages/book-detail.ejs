<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title><%= title %> — Bookie</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/auth.css" />
  </head>
  <body class="account-body">
    <main class="form-page book-detail-page">
      <a class="auth-back" href="/">← Back to books</a>
      <section class="book-detail-hero">
        <div class="detail-cover">
          <% if (book.imageUrl) { %>
          <img src="<%= book.imageUrl %>" alt="Cover of <%= book.title %>" />
          <% } else { %>
          <span><%= book.title.charAt(0) %></span>
          <% } %>
        </div>
        <div>
          <p class="auth-step"><%= book.genre.name %> · <%= book.language.name %></p>
          <h1>
            <%= book.title %>
          </h1>
          <p class="detail-author">by <%= book.author %></p>
          <p class="detail-description"><%= book.description %></p>
          <div class="detail-meta">
            <span>
              <strong>Publisher</strong>
              <%= book.publisher %>
            </span>
            <span>
              <strong>Year</strong>
              <%= book.publicationYear %>
            </span>
            <span>
              <strong>Condition</strong>
              <%= book.condition.name %>
            </span>
            <span>
              <strong>Pickup</strong>
              <%= book.pickupLocations.map((item) => item.city.name).join(String.fromCharCode(44,
              32)) || book.owner.city?.name || 'Not specified' %>
            </span>
          </div>
          <div class="detail-price">
            <strong>
              <%= book.price === 0 ? 'Exchange only' : `${book.price.toFixed(2)} KM` %>
            </strong>
            <% if (book.allowExchange) { %>
            <span>Exchange available</span>
            <% } %>
          </div>
          <% if (currentUser && currentUser.id !== book.owner.id) { %>
          <div class="detail-actions">
            <% if (book.price > 0) { %>
            <form method="post" action="/cart/<%= book.id %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button class="auth-submit" type="submit">Buy this book <span>↗</span></button>
            </form>
            <% } %>
            <a
              class="secondary-action"
              href="/chat/new?userId=<%= book.owner.id %>&bookId=<%= book.id %>"
              >Message seller</a>
          </div>
          <% } else if (!currentUser) { %>
          <p class="field-hint">
            <a href="/login">Log in</a> to buy, exchange or message the seller.
          </p>
          <% } %>
        </div>
      </section>
      <% if (currentUser && currentUser.role === 'BUYER' && currentUser.id !== book.owner.id && book.allowExchange && book.buyerBooks.length) { %>
      <section class="workflow-form exchange-panel">
        <h2>Offer a book in exchange</h2>
        <p class="field-hint">Choose your active exchange books.</p>
        <% if (exchangeError) { %>
        <p class="form-alert" role="alert">
          Choose at least one active book marked for exchange and try again.
        </p>
        <% } %>
        <form method="post" action="/exchange">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="sellerId" value="<%= book.owner.id %>" />
          <input type="hidden" name="bookId" value="<%= book.id %>" />
          <div class="interest-options">
            <% book.buyerBooks.forEach((offered) => { %>
            <label class="interest-chip">
              <input type="checkbox" name="offeredBookIds" value="<%= offered.id %>" required />
              <span>
                <%= offered.title %>
                ·
                <%= offered.author %>
              </span>
            </label>
            <% }) %>
          </div>
          <button class="auth-submit" type="submit">Send exchange offer <span>↗</span></button>
        </form>
      </section>
      <% } %>
      <section class="seller-card">
        <div class="seller-avatar">
          <% if (book.owner.avatarUrl) { %>
          <img src="<%= book.owner.avatarUrl %>" alt="<%= book.owner.name %>" />
          <% } else { %>
          <%= book.owner.firstName.charAt(0) %>
          <%= book.owner.lastName.charAt(0)
          %>
          <% } %>
        </div>
        <div>
          <p class="field-hint">Listed by</p>
          <a href="/users/<%= book.owner.id %>">
            <strong>
              <%= book.owner.name %>
            </strong>
          </a>
          <p><%= book.owner.city?.name || 'Location not specified' %></p>
        </div>
      </section>
      <section class="reviews-section">
        <h2>
          Reviews <span>(<%= book.reviews.length %>)</span>
        </h2>
        <% if (!book.reviews.length) { %>
        <p class="field-hint">No reviews yet.</p>
        <% } %>
        <div class="review-list">
          <% book.reviews.forEach((review) => { %>
          <article class="review-card">
            <div>
              <strong>
                <%= review.buyer.firstName %>
                <%= review.buyer.lastName %>
              </strong>
              <span class="stars">
                <%= '★'.repeat(review.rating) %>
                <%= '☆'.repeat(5 - review.rating) %>
              </span>
            </div>
            <p><%= review.comment || 'No written comment.' %></p>
            <small>
              <%= new Date(review.createdAt).toLocaleDateString('en-US') %>
            </small>
          </article>
          <% }) %>
        </div>
      </section>
    </main>
  </body>
</html>
