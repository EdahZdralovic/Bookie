generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                       @id @default(autoincrement())
  name                String
  firstName           String?
  lastName            String?
  email               String                    @unique
  passwordHash        String
  role                UserRole                  @default(BUYER)
  status              AccountStatus             @default(ACTIVE)
  avatarUrl           String?
  bio                 String?
  cityId              Int?
  city                City?                     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  blockedUntil        DateTime?
  archivedAt          DateTime?
  books               Book[]
  sessions            Session[]
  genreInterests      UserGenreInterest[]
  languageInterests   UserLanguageInterest[]
  cart                Cart?
  buyerOrders         Order[]                   @relation("BuyerOrders")
  sellerOrders        Order[]                   @relation("SellerOrders")
  reviews             Review[]                  @relation("BuyerReviews")
  conversationMembers ConversationParticipant[]
  messages            Message[]
  notifications       Notification[]
  reportsSent         Report[]                  @relation("ReportsSent")
  reportsReceived     Report[]                  @relation("ReportedUsers")
  reportsResolved     Report[]                  @relation("ReportsResolved")
  wishlistAlerts      WishlistAlert[]
  badges              UserBadge[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([role])
  @@index([status])
  @@index([cityId])
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model City {
  id           Int                  @id @default(autoincrement())
  name         String               @unique
  isActive     Boolean              @default(true)
  users        User[]
  pickupBooks  BookPickupLocation[]
  pickupPoints PickupPoint[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model Genre {
  id             Int                 @id @default(autoincrement())
  name           String              @unique
  slug           String              @unique
  isActive       Boolean             @default(true)
  books          Book[]
  userInterests  UserGenreInterest[]
  wishlistAlerts WishlistAlert[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Language {
  id             Int                    @id @default(autoincrement())
  name           String                 @unique
  code           String                 @unique
  isActive       Boolean                @default(true)
  books          Book[]
  userInterests  UserLanguageInterest[]
  wishlistAlerts WishlistAlert[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model BookCondition {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  books     Book[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  isActive  Boolean   @default(true)
  books     BookTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Book {
  id                  Int                  @id @default(autoincrement())
  title               String
  author              String
  publisher           String?
  publicationYear     Int?
  isbn                String?
  course              String?
  description         String?
  imageUrl            String?
  price               Decimal              @default(0)
  allowExchange       Boolean              @default(false)
  status              BookStatus           @default(ACTIVE)
  viewCount           Int                  @default(0)
  completedOrderCount Int                  @default(0)
  averageRating       Float                @default(0)
  ratingCount         Int                  @default(0)
  ownerId             Int
  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  genreId             Int?
  genre               Genre?               @relation(fields: [genreId], references: [id], onDelete: SetNull)
  languageId          Int?
  language            Language?            @relation(fields: [languageId], references: [id], onDelete: SetNull)
  conditionId         Int?
  condition           BookCondition?       @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  legacyCondition     String?              @map("condition")
  images              BookImage[]
  pickupLocations     BookPickupLocation[]
  tags                BookTag[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  offeredInExchanges  ExchangeOfferBook[]
  reviews             Review[]
  conversationBooks   ConversationBook[]
  reports             Report[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([genreId])
  @@index([languageId])
  @@index([conditionId])
  @@index([price])
  @@index([createdAt])
}

model BookImage {
  id        Int      @id @default(autoincrement())
  url       String
  altText   String?
  sortOrder Int      @default(0)
  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([bookId])
}

model BookPickupLocation {
  bookId Int
  cityId Int
  book   Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  city   City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([bookId, cityId])
}

model BookTag {
  bookId Int
  tagId  Int
  book   Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId])
}

model UserGenreInterest {
  userId  Int
  genreId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([userId, genreId])
}

model UserLanguageInterest {
  userId     Int
  languageId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([userId, languageId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([cartId, bookId])
  @@index([bookId])
}

model Order {
  id            Int            @id @default(autoincrement())
  orderNumber   String         @unique
  type          OrderType      @default(PURCHASE)
  status        OrderStatus    @default(PENDING)
  totalAmount   Decimal        @default(0)
  buyerNote     String?
  sellerNote    String?
  buyerId       Int
  buyer         User           @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId      Int
  seller        User           @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  exchangeOffer ExchangeOffer?
  conversations Conversation[]
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([createdAt])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Restrict)
  price     Decimal
  review    Review?
  createdAt DateTime @default(now())

  @@unique([orderId, bookId])
  @@index([bookId])
}

model ExchangeOffer {
  id           Int                 @id @default(autoincrement())
  orderId      Int                 @unique
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  note         String?
  offeredBooks ExchangeOfferBook[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model ExchangeOfferBook {
  exchangeOfferId Int
  bookId          Int
  exchangeOffer   ExchangeOffer @relation(fields: [exchangeOfferId], references: [id], onDelete: Cascade)
  book            Book          @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@id([exchangeOfferId, bookId])
  @@index([bookId])
}

model Review {
  id            Int       @id @default(autoincrement())
  rating        Int
  comment       String?
  buyerId       Int
  buyer         User      @relation("BuyerReviews", fields: [buyerId], references: [id], onDelete: Cascade)
  bookId        Int
  book          Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  orderItemId   Int       @unique
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  editableUntil DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([bookId])
  @@index([buyerId])
}

model Conversation {
  id           Int                       @id @default(autoincrement())
  subject      String?
  orderId      Int?
  order        Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  books        ConversationBook[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([orderId])
}

model ConversationParticipant {
  conversationId Int
  userId         Int
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model ConversationBook {
  conversationId Int
  bookId         Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  book           Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([conversationId, bookId])
  @@index([bookId])
}

model Message {
  id             Int          @id @default(autoincrement())
  body           String
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model Report {
  id             Int          @id @default(autoincrement())
  reason         String
  details        String?
  status         ReportStatus @default(OPEN)
  reporterId     Int
  reporter       User         @relation("ReportsSent", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId Int?
  reportedUser   User?        @relation("ReportedUsers", fields: [reportedUserId], references: [id], onDelete: SetNull)
  bookId         Int?
  book           Book?        @relation(fields: [bookId], references: [id], onDelete: SetNull)
  resolvedById   Int?
  resolvedBy     User?        @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([bookId])
}

model WishlistAlert {
  id         Int       @id @default(autoincrement())
  query      String?
  author     String?
  isbn       String?
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  genreId    Int?
  genre      Genre?    @relation(fields: [genreId], references: [id], onDelete: SetNull)
  languageId Int?
  language   Language? @relation(fields: [languageId], references: [id], onDelete: SetNull)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PickupPoint {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  type      String?
  cityId    Int
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([cityId, name])
}

model Badge {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String
  icon        String?
  users       UserBadge[]
  createdAt   DateTime    @default(now())
}

model UserBadge {
  userId    Int
  badgeId   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@id([userId, badgeId])
}

enum UserRole {
  ADMIN
  SELLER
  BUYER
  STUDENT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  ARCHIVED
}

enum BookStatus {
  ACTIVE
  RESERVED
  SOLD
  EXCHANGED
  ARCHIVED
  AVAILABLE
}

enum OrderType {
  PURCHASE
  EXCHANGE
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  ORDER
  MESSAGE
  REVIEW
  SYSTEM
  WISHLIST_MATCH
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}
